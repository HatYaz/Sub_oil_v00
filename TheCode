        # Live R readout
        self.r_lbl = styled_label("R = Uₒ/Uᵥ = —", GOLD, 11, bold=True)
        self.r_lbl.setAlignment(Qt.AlignCenter)
        self.sp_Uo.valueChanged.connect(self._update_R)
        self.sp_Uw.valueChanged.connect(self._update_R)
        root.addWidget(self.r_lbl)

        # ── Simulation time card ──────────────────────────────────────────
        tc = card("⏱  Simulation Time")
        tgrid = QGridLayout(tc)
        self.sp_t   = styled_spinbox(10.0, 1.0, 30.0, 0.5, 1)
        self.sp_dt  = styled_spinbox(0.2,  0.1,  1.0, 0.1, 1)
        tgrid.addWidget(styled_label("Total time",  TEXT_SEC, 10), 0, 0)
        tgrid.addWidget(self.sp_t, 0, 1)
        tgrid.addWidget(styled_label("s", TEXT_SEC, 9), 0, 2)
        tgrid.addWidget(styled_label("Output every", TEXT_SEC, 10), 1, 0)
        tgrid.addWidget(self.sp_dt, 1, 1)
