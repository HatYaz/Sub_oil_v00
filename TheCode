class DarkCanvas(FigureCanvas):
    def __init__(self, nrows=1, ncols=1, figsize=(8, 5)):
        self.fig = Figure(figsize=figsize, facecolor=PLOT_BG)
        super().__init__(self.fig)
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)
        self.setStyleSheet(f"background-color:{PLOT_BG}; border:none;")

    def _style_ax(self, ax, title="", xlabel="", ylabel=""):
        ax.set_facecolor(PLOT_BG)
        ax.tick_params(colors=TEXT_SEC, labelsize=8)
        ax.xaxis.label.set_color(TEXT_SEC)
        ax.yaxis.label.set_color(TEXT_SEC)
        ax.set_xlabel(xlabel, fontsize=8)
        ax.set_ylabel(ylabel, fontsize=8)
        if title:
            ax.set_title(title, color=TEXT_PRIM, fontsize=9, fontweight="bold", pad=4)
        for spine in ax.spines.values():
            spine.set_color(SPINE_COL)
        ax.grid(True, color=PLOT_GRID, linewidth=0.5, alpha=0.6)


# ─────────────────────────────────────────────────────────────────────────────
#  MAIN PROPAGATION CANVAS  — 2 × 2 grid
# ─────────────────────────────────────────────────────────────────────────────
class PropagationCanvas(DarkCanvas):
    def __init__(self):
        super().__init__(figsize=(11, 7))
        self.fig.patch.set_facecolor(BG_DARK)
        gs = gridspec.GridSpec(2, 2, figure=self.fig,
                               hspace=0.38, wspace=0.28,
                               left=0.07, right=0.97, top=0.93, bottom=0.07)
        self.ax_oil  = self.fig.add_subplot(gs[0, 0])   # oil fraction
        self.ax_turb = self.fig.add_subplot(gs[0, 1])   # turbulence k
        self.ax_vel  = self.fig.add_subplot(gs[1, 0])   # velocity field
        self.ax_traj = self.fig.add_subplot(gs[1, 1])   # trajectory + R1

        for ax in [self.ax_oil, self.ax_turb, self.ax_vel, self.ax_traj]:
            self._style_ax(ax)

        # Persistent objects updated each frame
        self._im_oil  = None
        self._im_turb = None
        self._cb_oil  = None
        self._cb_turb = None
        self._cb_vel = None
        self._im_vel = None 
        self._traj_x  = []
        self._traj_y  = []
        self._r1_vals = []
        self._r_vals  = []

        self._init_axes()

    def _init_axes(self):
        self._style_ax(self.ax_oil,  "Oil Volume Fraction (F_o)",
                       "Horizontal distance (m)", "Vertical depth (m)")
        self._style_ax(self.ax_turb, "Turbulent Kinetic Energy  k  [m²/s²]",
                       "Horizontal distance (m)", "Vertical depth (m)")
        self._style_ax(self.ax_vel,  "Velocity Field  |u|",
                       "Horizontal distance (m)", "Vertical depth (m)")
        self._style_ax(self.ax_traj, "Plume Trajectory & R₁ vs R",
                       "R  (= Uₒ / Uᵥ)", "R₁  (= Uₒ₁ / Uᵥ₁)")
        self.draw()

    def _add_cbar(self, ax, im, label):
        cb = self.fig.colorbar(im, ax=ax, fraction=0.03, pad=0.01)
        cb.ax.tick_params(colors=TEXT_SEC, labelsize=7)
        cb.set_label(label, color=TEXT_SEC, fontsize=7)
        cb.outline.set_edgecolor(SPINE_COL)
        return cb

    def update_frame(self, frame, physics, all_frames):
            F_o   = frame['F_o']
            k     = frame['k']
            u, v  = frame['u'], frame['v']
            cx, cy = frame['cx'], frame['cy']
            t      = frame['t']
            X, Y   = physics.X, physics.Y

            # -------------------------------
            # Oil fraction
            # -------------------------------
            if self._im_oil is None:
                self._im_oil = self.ax_oil.contourf(
                    X, Y, F_o, levels=30, cmap=OIL_CMAP, vmin=0, vmax=1
                )
                # add colorbar
                self._cb_oil = self._add_cbar(self.ax_oil, self._im_oil, "F_o")
            else:
                for c in self._im_oil.collections:
                    c.remove()
                self._im_oil = self.ax_oil.contourf(
                    X, Y, F_o, levels=30, cmap=OIL_CMAP, vmin=0, vmax=1
                )
                # update colorbar
                if self._cb_oil: 
                    self._cb_oil.remove()
                self._cb_oil = self._add_cbar(self.ax_oil, self._im_oil, "F_o")

            self.ax_oil.plot(physics.x_leak, 0, 'v', color=ACCENT_3, ms=8)
            self.ax_oil.plot(cx, cy, 'o', color=GOLD, ms=7,
                            markeredgecolor=TEXT_PRIM, markeredgewidth=0.6)
            self.ax_oil.axhline(physics.Ly, color=ACCENT_1, lw=1.0,
                                linestyle='--', alpha=0.6)

            # -------------------------------
            # Turbulence k
            # -------------------------------
            k_log = np.log10(np.maximum(k, 1e-6))
            if self._im_turb is None:
                self._im_turb = self.ax_turb.contourf(
                    X, Y, k_log, levels=30, cmap=TURB_CMAP,
                    vmin=np.log10(1e-6), vmax=np.log10(1.0)
                )
                self._cb_turb = self._add_cbar(self.ax_turb, self._im_turb, "log10(k)")
            else:
                for c in self._im_turb.collections:
                    c.remove()
                self._im_turb = self.ax_turb.contourf(
                    X, Y, k_log, levels=30, cmap=TURB_CMAP,
                    vmin=np.log10(1e-6), vmax=np.log10(1.0)
                )
                if self._cb_turb:
                    self._cb_turb.remove()
                self._cb_turb = self._add_cbar(self.ax_turb, self._im_turb, "log10(k)")

            # -------------------------------
            # Velocity field magnitude
            # -------------------------------
            vel_mag = np.sqrt(u**2 + v**2)
            if self._im_vel is None:
                self._im_vel = self.ax_vel.contourf(
                    X, Y, vel_mag, levels=25,
                    cmap='plasma',
                    vmin=0, vmax=max(vel_mag.max(), 0.5)
                )
                self._cb_vel = self._add_cbar(self.ax_vel, self._im_vel, "|u| [m/s]")
            else:
                for c in self._im_vel.collections:
                    c.remove()
                self._im_vel = self.ax_vel.contourf(
                    X, Y, vel_mag, levels=25,
                    cmap='plasma',
                    vmin=0, vmax=max(vel_mag.max(), 0.5)
                )
                if self._cb_vel:
                    self._cb_vel.remove()
                self._cb_vel = self._add_cbar(self.ax_vel, self._im_vel, "|u| [m/s]")

            # Quiver arrows
            [q.remove() for q in self.ax_vel.collections if isinstance(q, matplotlib.quiver.Quiver)]
            sx, sy = max(1, physics.nx // 20), max(1, physics.ny // 12)
            Xq = X[::sy, ::sx]; Yq = Y[::sy, ::sx]
            uq = u[::sy, ::sx]; vq = v[::sy, ::sx]
            self.ax_vel.quiver(Xq, Yq, uq, vq,
                            color="white", alpha=0.55, scale=30,
                            width=0.003, headwidth=3)

            # -------------------------------
            # Trajectory & R1
            # -------------------------------
            idx = next((i for i, f in enumerate(all_frames) if f is frame), 0)
            r_hist  = [f['R']  for f in all_frames[:idx + 1]]
            r1_hist = [f['R1'] for f in all_frames[:idx + 1]]

            self.ax_traj.cla()
            self._style_ax(self.ax_traj, "R₁ Correlation", "R", "R₁")
            R_fit_x = np.linspace(20, 150, 300)
            R_fit_y = 0.66932 + 0.00215 * R_fit_x
            self.ax_traj.plot(R_fit_x, R_fit_y, '--', color=ACCENT_2)
            self.ax_traj.scatter(r_hist, r1_hist, c=ACCENT_1, s=20, alpha=0.7)
            self.ax_traj.set_xlim(0, 160)
            self.ax_traj.set_ylim(0, 1.2)

            self.fig.canvas.draw_idle()
    def clear_plots(self):
        """Clear all plots and reset trajectory/history."""
        # Remove oil fraction
        if self._im_oil is not None:
            for c in self._im_oil.collections:
                c.remove()
            self._im_oil = None

        # Remove turbulence
        if self._im_turb is not None:
            for c in self._im_turb.collections:
                c.remove()
            self._im_turb = None

        # Remove velocity field
        if self._im_vel is not None:
            for c in self._im_vel.collections:
                c.remove()
            self._im_vel = None
        # Remove quivers
        self.ax_vel.cla()
        self._style_ax(self.ax_vel, "Velocity Field  |u|",
                       "Horizontal distance (m)", "Vertical depth (m)")

        # Reset trajectory plot
        self.ax_traj.cla()
        self._style_ax(self.ax_traj, "Plume Trajectory & R₁ vs R",
                       "R  (= Uₒ / Uᵥ)", "R₁  (= Uₒ₁ / Uᵥ₁)")
        self._traj_x.clear()
        self._traj_y.clear()
        self._r1_vals.clear()
        self._r_vals.clear()

        # Redraw all axes
        self.ax_oil.cla()
        self._style_ax(self.ax_oil,  "Oil Volume Fraction (F_o)",
                       "Horizontal distance (m)", "Vertical depth (m)")
        self.ax_turb.cla()
        self._style_ax(self.ax_turb, "Turbulent Kinetic Energy  k  [m²/s²]",
                       "Horizontal distance (m)", "Vertical depth (m)")
        self.fig.canvas.draw_idle()
    
