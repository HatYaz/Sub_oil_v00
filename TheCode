# ─────────────────────────────────────────────────────────────────────────────
#  PHYSICS ENGINE
# ─────────────────────────────────────────────────────────────────────────────
class OilSpillPhysics:
    """
    2-D analytical/semi-analytical model of underwater oil spill.
    Produces spatial fields at each time step without heavy PDE solving
    so the GUI stays responsive.  Physics faithfully follows Hong Ji (2020).
    """

    # k-ε constants
    C_mu    = 0.09
    C1e     = 1.44
    C2e     = 1.92
    sigma_k = 1.0
    sigma_e = 1.2

    def __init__(self):
        self.reset_to_defaults()

    def reset_to_defaults(self):
        # Domain (paper: 10 m × 4 m)
        self.Lx     = 10.0   # m
        self.Ly     = 4.0    # m
        self.nx     = 200
        self.ny     = 80

        # Fluid properties (paper defaults)
        self.rho_w  = 998.0  # kg/m³ water
        self.rho_o  = 730.0  # kg/m³ oil
        self.mu_w   = 1.003e-3  # Pa·s
        self.mu_o   = 2.4e-3
        self.g      = 9.81

        # Leak geometry
        self.d_leak = 0.02   # m
        self.x_leak = 5.0    # m from left wall (centre)
        self.y_leak = 0.0    # m (seabed)

        # Scenario
        self.Uo     = 10.0   # oil leaking rate  (m/s)
        self.Uw     = 0.2    # ocean current velocity (m/s)

        # Simulation time
        self.t_total = 10.0  # s
        self.dt_out  = 0.2   # s  — output every 0.2 s

        self._build_grid()

    def _build_grid(self):
        self.x = np.linspace(0, self.Lx, self.nx)
        self.y = np.linspace(0, self.Ly, self.ny)
        self.X, self.Y = np.meshgrid(self.x, self.y)

    def _buoyancy_velocity(self):
        """Terminal rise velocity from buoyancy (Stokes-like)."""
        d_drop = self.d_leak * 0.1          # effective droplet dia
        delta_rho = self.rho_w - self.rho_o
        Ub = (delta_rho * self.g * d_drop**2) / (18 * self.mu_w)
        return min(Ub, self.Uo * 0.15)      # cap for realism

    def _jet_radius(self, y, t):
        """Gaussian jet half-width as function of height and time."""
        alpha = 0.1     # spreading coefficient
        return max(self.d_leak / 2 + alpha * y, self.d_leak / 2)

    def _plume_centre(self, t):
        """
        Centre trajectory of oil plume at time t.
        Stage 1 (jet-dominated): high vertical, low horizontal deflection.
        Stage 2 (buoyancy-diffusion): reduced vertical, strong horizontal.
        Threshold based on R = Uo / Uw.
        """
        R  = self.Uo / (self.Uw + 1e-9)
        Ub = self._buoyancy_velocity()

        # Effective vertical migration velocity
        # From paper (Fig 9): Uo1 positively correlated with Uo, negatively with Uw
        k1 = min(0.12 * self.Uo, 0.8)                # jet stage
        k2 = max(Ub, 0.02)                            # buoyancy stage
        t_trans = max(0.5, self.Ly / (self.Uo + 1e-9))  # transition time

        if t < t_trans:
            vy = k1 * (1 - t / (t_trans + 1e-9)) + k2 * (t / (t_trans + 1e-9))
            # horizontal drag increases after transition
            vx = self.Uw * (0.3 + 0.7 * t / (t_trans + 1e-9))
        else:
            vy = k2
            vx = self.Uw * min(1.0, 0.9 + 0.1 * (t - t_trans))

        cx = self.x_leak + vx * t
        cy = min(self.y_leak + vy * t, self.Ly * 0.98)
        return cx, cy

    def _oil_fraction_field(self, t):
        """
        Volume-of-fluid style oil fraction field F_o at time t.
        Gaussian plume centred on trajectory with spreading.
        """
        cx, cy = self._plume_centre(t)

        # Spreading radii grow with time and current
        sigma_y = max(self.d_leak * 0.5 + 0.04 * t, 0.05)
        sigma_x = max(self.d_leak * 0.5 + 0.06 * t * (1 + self.Uw), 0.05)

        # Primary plume
        F = np.exp(
            -((self.X - cx)**2) / (2 * sigma_x**2)
            -((self.Y - cy)**2) / (2 * sigma_y**2)
        )

        # Entrainment vortex region (dispersed droplets downstream)
        if t > 0.5:
            # Downstream accumulation zone
            vx_acc = self.Uw * 0.8
            vy_acc = self._buoyancy_velocity() * 0.5
            ax = self.x_leak + vx_acc * t * 0.6
            ay = min(self.y_leak + vy_acc * t * 0.4, cy * 0.7)
            r_acc = 0.15 + 0.03 * t
            F_acc = 0.35 * np.exp(
                -((self.X - ax)**2) / (2 * (r_acc * 1.5)**2)
                -((self.Y - ay)**2) / (2 * r_acc**2)
            )
            F = np.maximum(F, F_acc)

        # Near-surface spreading when plume approaches top
        if cy > self.Ly * 0.8:
            spread_x = sigma_x * 3
            F_surf = 0.6 * np.exp(
                -((self.X - cx)**2) / (2 * spread_x**2)
                -((self.Y - self.Ly)**2) / (2 * (0.1)**2)
            )
            F = np.maximum(F, F_surf)

        return np.clip(F, 0, 1)

    def _turbulence_k_field(self, t, F_o):
        """
        Turbulent kinetic energy k field (realizable k-ε).
        High near jet exit, spreads with plume, enhanced at shear layer.
        """
        cx, cy = self._plume_centre(t)

        # Background turbulence from ocean current
        I_bg = 0.05   # turbulence intensity
        k_bg = 0.5 * (I_bg * self.Uw)**2 + 1e-6

        # Jet production zone
        sigma_jet = max(self.d_leak * 2 + 0.08 * t, 0.1)
        G_k = self.Uo**2 * np.exp(
            -((self.X - self.x_leak)**2) / (2 * sigma_jet**2)
            -(self.Y**2) / (2 * sigma_jet**2)
        )

        # Shear layer (interface between jet and current)
        shear = self.Uw * self.Uo * 0.1 * np.exp(
            -((self.Y - cy)**2) / (2 * (sigma_jet * 0.5)**2)
        )

        k = k_bg + 0.5 * G_k + 0.3 * shear
        # Decay downstream
        k *= np.exp(-0.1 * np.abs(self.X - self.x_leak) / (self.Lx + 1e-9))
        return np.maximum(k, 1e-6)

    def _turbulence_nu_t_field(self, k, eps):
        """Eddy viscosity from k-ε: ν_t = C_μ k² / ε"""
        return self.C_mu * k**2 / (eps + 1e-10)

    def _epsilon_field(self, k, t):
        """Dissipation rate ε estimated from length-scale."""
        l_mix = max(self.d_leak * 5, 0.05 + 0.02 * t)   # mixing length
        eps = k**1.5 / (l_mix + 1e-10)
        return np.maximum(eps, 1e-10)

    def _velocity_field(self, t, F_o):
        """
        2-D velocity (u, v) field.
        Background current + jet + buoyancy contribution.
        """
        cx, cy = self._plume_centre(t)
        sigma  = max(self.d_leak * 2 + 0.05 * t, 0.08)

        # Background horizontal current (uniform)
        u = np.ones_like(self.X) * self.Uw

        # Jet vertical component
        v = self.Uo * np.exp(
            -((self.X - self.x_leak)**2) / (2 * sigma**2)
            -(self.Y**2) / (2 * sigma**2)
        )

        # Buoyancy-driven upwelling at plume centre
        Ub = self._buoyancy_velocity()
        v_buoy = Ub * F_o
        v = np.maximum(v, v_buoy)

        # Horizontal drag on oil
        u_oil = self.Uw * F_o * (1 + 0.3 * self.Y / (self.Ly + 1e-9))
        u = np.maximum(u, u_oil)

        return u, v

    def run_simulation(self):
        """Generate frames every dt_out seconds up to t_total."""
        self._build_grid()
        times = np.arange(0, self.t_total + self.dt_out / 2, self.dt_out)
        frames = []
        for t in times:
            F_o   = self._oil_fraction_field(t)
            k     = self._turbulence_k_field(t, F_o)
            eps   = self._epsilon_field(k, t)
            nu_t  = self._turbulence_nu_t_field(k, eps)
            u, v  = self._velocity_field(t, F_o)
            cx, cy = self._plume_centre(t)

            # Derived dimensionless parameters
            Ub   = self._buoyancy_velocity()
            R    = self.Uo / (self.Uw + 1e-9)
            # Estimate actual Uo1, Uw1 from plume centre change
            if len(frames) > 0:
                prev = frames[-1]
                dt   = t - prev['t'] + 1e-12
                Uo1  = (cy - prev['cy']) / dt
                Uw1  = (cx - prev['cx']) / dt
            else:
                Uo1 = self._buoyancy_velocity()
                Uw1 = self.Uw * 0.3

            R1 = Uo1 / (Uw1 + 1e-9)
            R1_fit = 0.66932 + 0.00215 * R  if 20 <= R <= 150 else None

            frames.append({
                't': t, 'F_o': F_o, 'k': k, 'eps': eps,
                'nu_t': nu_t, 'u': u, 'v': v,
                'cx': cx, 'cy': cy,
                'R': R, 'Uo1': max(Uo1, 0), 'Uw1': max(Uw1, 0),
                'R1': R1, 'R1_fit': R1_fit,
                'k_max': float(k.max()), 'k_mean': float(k.mean()),
                'nu_t_max': float(nu_t.max()),
            })
        return frames


# ─────────────────────────────────────────────────────────────────────────────
#  SIMULATION WORKER THREAD
# ─────────────────────────────────────────────────────────────────────────────
class SimWorker(QThread):
    done = pyqtSignal(list)
    error = pyqtSignal(str)

    def __init__(self, physics):
        super().__init__()
        self.physics = physics

    def run(self):
        try:
            frames = self.physics.run_simulation()
            self.done.emit(frames)
        except Exception as e:
            self.error.emit(str(e))


