        ph.d_leak  = p['d_leak']
        ph.x_leak  = p['x_leak']
        ph.t_total = p['t_total']
        ph.dt_out  = p['dt_out']

        self.btn_run.setEnabled(False)
        self.btn_run.setText("⏳  Computing…")
        self.progress.setVisible(True)
        self.statusBar().showMessage("Running simulation…")

        self._worker = SimWorker(self.physics)
        self._worker.done.connect(self._on_sim_done)
        self._worker.error.connect(self._on_sim_error)
        self._worker.start()

    def _on_sim_done(self, frames):
        self.frames = frames
        self._cur_idx = 0
        self.progress.setVisible(False)
        self.btn_run.setEnabled(True)
        self.btn_run.setText("▶  RUN SIMULATION")

        n = len(frames)
        self.timeline.configure(n, self.physics.t_total)
        self._render_frame(0)
        self.statusBar().showMessage(
            f"Done — {n} frames · Δt = {self.physics.dt_out:.1f} s  "
            f"·  Press ▶ Play to animate  ·  Or drag the timeline slider")

    def _on_sim_error(self, msg):
        self.progress.setVisible(False)
        self.btn_run.setEnabled(True)
        self.btn_run.setText("▶  RUN SIMULATION")
        QMessageBox.critical(self, "Simulation Error", msg)

    # ── Playback ──────────────────────────────────────────────────────────────
    def _toggle_play(self):
        if not self.frames:
            return
        self._playing = not self._playing
        if self._playing:
            self.timeline.play_btn.setText("⏸  Pause")
            self.timeline.play_btn.setStyleSheet(
                self.timeline.play_btn.styleSheet().replace(ACCENT_2, ACCENT_3))
            self._update_speed()
            self._timer.start()
        else:
            self._playing = False
            self.timeline.play_btn.setText("▶  Play")
            self._timer.stop()

    def _update_speed(self):
        base_ms = 150  # base interval
        spd = self.timeline.get_speed()
        self._timer.setInterval(int(base_ms / spd))

    def _advance_frame(self):
        if not self.frames:
            return
        nxt = self._cur_idx + 1
        if nxt >= len(self.frames):
            nxt = 0  # loop
        self.timeline.set_frame(nxt)   # triggers _on_slider → _render_frame

    def _on_slider(self, idx):
        self._cur_idx = idx
        t = idx * self.physics.dt_out
        self.timeline.t_lbl.setText(f"t = {t:.1f} s")
        if self.frames:
            self._render_frame(idx)

    def _render_frame(self, idx):
        if not self.frames or idx >= len(self.frames):
            return
        frame = self.frames[idx]
        self.canvas.update_frame(frame, self.physics, self.frames)
        self.metrics.update(frame)

    def closeEvent(self, event):
        self._timer.stop()
        plt.close('all')
        event.accept()


