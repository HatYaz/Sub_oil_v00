def styled_label(text, color=TEXT_PRIM, size=10, bold=False):
    lbl = QLabel(text)
    w = "bold" if bold else "normal"
    lbl.setStyleSheet(f"color:{color}; font-size:{size}px; font-weight:{w};")
    return lbl


def styled_spinbox(val, lo, hi, step, dec=2):
    sb = QDoubleSpinBox()
    sb.setRange(lo, hi)
    sb.setValue(val)
    sb.setSingleStep(step)
    sb.setDecimals(dec)
    sb.setStyleSheet(f"""
        QDoubleSpinBox {{
            background:{BG_HOVER}; color:{TEXT_PRIM}; border:1px solid {BORDER};
            border-radius:4px; padding:3px 6px; font-size:11px;
        }}
        QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {{
            background:{BG_CARD}; border:none; width:16px;
        }}
    """)
    return sb


