        self.sp_Uo  = styled_spinbox(10.0,  0.1,  20.0, 0.5,  2)
        self.sp_Uw  = styled_spinbox(0.2,   0.01,  2.0,  0.05, 3)
        self.sp_rho_o = styled_spinbox(730.0, 600, 900,  10,   1)
        self.sp_rho_w = styled_spinbox(998.0, 990, 1030,  1,   1)
        self.sp_mu_o  = styled_spinbox(2.4,   0.1,  20,   0.1,  2)
        self.sp_mu_w  = styled_spinbox(1.003, 0.5,   5,   0.1,  3)
        self.sp_d     = styled_spinbox(0.02,  0.005, 0.1, 0.005,3)
        self.sp_xleak = styled_spinbox(5.0,   0.5,   9.5, 0.5,  1)

        row(0, "Oil leak rate Uₒ",  self.sp_Uo,   "m/s")
        row(1, "Current Uᵥ",        self.sp_Uw,   "m/s")
        row(2, "Oil density ρₒ",    self.sp_rho_o,"kg/m³")
        row(3, "Water density ρᵥ",  self.sp_rho_w,"kg/m³")
        row(4, "Oil viscosity μₒ",  self.sp_mu_o, "×10⁻³ Pa·s")
        row(5, "Water visc. μᵥ",    self.sp_mu_w, "×10⁻³ Pa·s")
        row(6, "Leak diameter d",   self.sp_d,    "m")
        row(7, "Leak position x",   self.sp_xleak,"m")
