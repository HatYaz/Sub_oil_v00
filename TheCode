        root.addStretch(1)
        self._update_R()

    def _update_R(self):
        R = self.sp_Uo.value() / (self.sp_Uw.value() + 1e-9)
        colour = ACCENT_3 if R < 10 else (ACCENT_2 if R <= 150 else ACCENT_4)
        self.r_lbl.setText(f"R = Uₒ/Uᵥ = {R:.1f}")
        self.r_lbl.setStyleSheet(
            f"color:{colour}; font-size:12px; font-weight:bold; "
            f"background:{BG_CARD}; border:1px solid {colour}; "
            f"border-radius:4px; padding:4px 8px;"
        )

    def _load_preset(self, txt):
        if txt in self.PRESETS:
            p = self.PRESETS[txt]
            self.sp_Uo.setValue(p['Uo'])
            self.sp_Uw.setValue(p['Uw'])
            self.sp_rho_o.setValue(p['rho_o'])
            self.sp_d.setValue(p['d'])
            self.sp_t.setValue(p['t'])
            self.sp_dt.setValue(p['dt'])

    def load_defaults(self):
        self.preset_cb.setCurrentIndex(0)
        p = self.DEFAULTS
        self.sp_Uo.setValue(p['Uo'])
        self.sp_Uw.setValue(p['Uw'])
        self.sp_rho_o.setValue(p['rho_o'])
        self.sp_d.setValue(p['d'])
        self.sp_t.setValue(p['t'])
        self.sp_dt.setValue(p['dt'])

    def get_params(self):
        return dict(
            Uo=self.sp_Uo.value(),
            Uw=self.sp_Uw.value(),
            rho_o=self.sp_rho_o.value(),
            rho_w=self.sp_rho_w.value(),
            mu_o=self.sp_mu_o.value() * 1e-3,
            mu_w=self.sp_mu_w.value() * 1e-3,
            d_leak=self.sp_d.value(),
            x_leak=self.sp_xleak.value(),
            t_total=self.sp_t.value(),
            dt_out=self.sp_dt.value(),
        )

class MainWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Subsea Oil Spill Simulator")
        self.setGeometry(50, 50, 1400, 800)
        self.setStyleSheet(f"background-color:{BG_DARK}; color:{TEXT_PRIM};")

        # ─ Layout ───────────────────────────────────────
        central = QWidget()
        self.setCentralWidget(central)
        layout = QHBoxLayout(central)

        # Parameter panel
        self.param_panel = ParamPanel()
        layout.addWidget(self.param_panel, 0)

        # Propagation canvas
        self.canvas = PropagationCanvas()
        layout.addWidget(self.canvas, 1)

        # ─ Buttons and progress ─────────────────────────
        control_panel = QVBoxLayout()
        self.btn_run = primary_btn("▶ Run Simulation")
        self.btn_run.clicked.connect(self.start_simulation)
        self.progress = QProgressBar()
        self.progress.setRange(0, 100)
        self.progress.setValue(0)
        control_panel.addWidget(self.btn_run)
        control_panel.addWidget(self.progress)
        layout.addLayout(control_panel)

        # Simulation variables
        self.frames = []
        self.current_frame = 0
        self.timer = QTimer()
        self.timer.timeout.connect(self.next_frame)

        # Physics engine
        self.physics = OilSpillPhysics()

    # ─ Start simulation in a separate thread ─────────
    def start_simulation(self):
        # Update physics from GUI inputs
        self.physics.Uo  = self.param_panel.sp_Uo.value()
        self.physics.Uw  = self.param_panel.sp_Uw.value()
        self.physics.rho_o = self.param_panel.sp_rho_o.value()
        self.physics.d_leak = self.param_panel.sp_d.value()
        self.physics.t_total = self.param_panel.sp_t.value()
        self.physics.dt_out = self.param_panel.sp_dt.value()
        self.physics._build_grid()

        # Disable run button
        self.btn_run.setEnabled(False)
        self.progress.setValue(0)
        self.frames = []
        self.current_frame = 0

        # Start worker
        self.worker = SimWorker(self.physics)
        self.worker.done.connect(self.simulation_done)
        self.worker.error.connect(self.simulation_error)
        self.worker.start()

    # ─ Called when simulation completes ─────────────
    def simulation_done(self, frames):
        self.frames = frames
        self.progress.setMaximum(len(frames))
        self.current_frame = 0
        self.timer.start(50)  # update every 50 ms

    def simulation_error(self, msg):
        QMessageBox.critical(self, "Simulation Error", msg)
        self.btn_run.setEnabled(True)

    # ─ Animate frame by frame ───────────────────────
    def next_frame(self):
        if self.current_frame >= len(self.frames):
            self.timer.stop()
            self.btn_run.setEnabled(True)
            return

        frame = self.frames[self.current_frame]
        self.canvas.update_frame(frame, self.physics, self.frames)
        self.current_frame += 1
        self.progress.setValue(self.current_frame)
